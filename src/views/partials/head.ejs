<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="<%= description %>">

<title><%= title %></title>

<link rel="icon" href="/images/one_one_favicon.ico">
<link rel="stylesheet" href="/css/base.css">
<link rel="stylesheet" href="/css/larger.css">

<% if (locals.isProduction) { %>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3LGZLSXT8Z"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-3LGZLSXT8Z');
    </script>
<% } %>

<% if (styles && styles.length > 0) { %>
    <% styles.forEach((style) => { %>
        <%- style %>
    <% }); %>
<% } %>
<% if (scripts && scripts.length > 0) { %>
    <% scripts.forEach((script) => { %>
        <%- script %>
    <% }); %>
<% } %>