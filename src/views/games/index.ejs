<%- include('../partials/countdown') %>
<!--All images on this page must be in a 8 by 10 aspect ratio-->
<div class="game-panel">
   <!--<div class="nav_mini position-1-about">
        <div class="nav_mini_main">
            <a href="#mysteryShack">The MysteryShack</a>
        </div>
    </div>-->
    <div>
        <h3>Get your number</h3>
        <h1></h1>
    </div>
    <% if (games && games.length > 0) { %>
        <% games.forEach((games, index) => { %>
            <%
                let cardClasses = 'games-panel-card ';
                let cardIds = '';

                if(games.order) {
                    cardClasses += `position-${games.order.position}-about`;
                }

                if(games.id) {
                    cardIds += `${games.id}`;
                }
            %>
            <div class="<%= cardClasses %>" id="<%= cardIds %>">
                <div class="games-panel-card-text">
                    <h3><%= games.title %></h3>
                    <p><%= games.description %></p>
                    <% if (games.button && games.button.length > 0) { %>
                        <% games.button.forEach(btn => { %>
                            <a href="<%= btn.href %>" target="<%= btn.target %>"><%= btn.text %></a>
                        <% }) %>
                    <% } %>
                </div>
                <picture>
                    <source srcset="images/<%= games.image.src %>-small.webp" media="(max-width: 500px)">
                    <source srcset="images/<%= games.image.src %>-medium.webp" media="(max-width: 1000px)">
                    <img class="games-panel-card-image" src="images/<%= games.image.src %>-min.webp" alt="<%= games.image.alt %>">
                </picture>
            </div>
        <% }) %>
    <% } else { %>
        <h2>"Oh! Uh... it's broken! I broke it" ~One-One</h2>
    <% } %>
</div>