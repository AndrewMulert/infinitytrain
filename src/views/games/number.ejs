<%- include('../partials/countdown') %>

<div class="ar-container">
    <video id="webcam" autoplay playsinline></video>
    <canvas id="ar-canvas"></canvas>

    <div class="controls">
        <button id="flip-camera-btn" class="number_btn btn-primary" type="button" aria-label="Flip Camera"><svg id="home_svg" width="20px" height="20px"><image width="20px" height="20px" href="/images/svg_camera_rotate.svg"></image></svg></button>
        <button id="capture-btn" class="number_btn btn-outline" type="button" aria-label="Take Photo"><svg id="home_svg" width="20px" height="20px"><image width="20px" height="20px" href="/images/svg_camera.svg"></image></svg></button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js" crossorigin="anonymous"></script>

<script src="/js/number-ar.js"></script>